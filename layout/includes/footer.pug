#footer-banner
  .footer-banner-links
    .footer-banner-left
      .footer-banner-left
        - const text = theme.footer_left
        span.footer-banner-link=text
        #footer-banner-tips
          
    if theme.footer_link
      .footer-banner-right
        each value, label in theme.footer_link
          if typeof value !== 'object'
            - const [link, icon] = value.split('||').map(part => trim(part))
            a.footer-banner-link(href=url_for(link))
              if icon
                i.fa-fw(class=icon)
              span= ' ' + label